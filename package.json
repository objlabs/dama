{
  "name": "dama",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted application and MCP operations control plane",
  "type": "module",
  "engines": {
    "node": ">=22.11.0"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json && tsc --project tsconfig.browser.json && node dist/scripts/copy-assets.js",
    "build:installers": "bash scripts/build-installers.sh",
    "check": "tsc --project tsconfig.json --noEmit && tsc --project tsconfig.browser.json --noEmit",
    "prestart": "npm run build",
    "start": "node --experimental-sqlite dist/src/server.js",
    "dev": "npm run build && node dist/scripts/dev.js",
    "pretest": "npm run build",
    "test": "node --experimental-sqlite --test dist/test/*.test.js",
    "nginx:config": "npm run --silent build && node dist/src/export-nginx.js",
    "db:shared": "node dist/scripts/shared-database.js",
    "deploy:worker": "node --experimental-sqlite dist/src/run-deployments.js"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "typescript": "5.7.3"
  }
}
