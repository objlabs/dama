[Unit]
Description=Dama local dashboard
Wants=docker.service
After=docker.service

[Service]
Type=simple
User=dama
Group=dama
SupplementaryGroups=docker
WorkingDirectory=/opt/dama
StateDirectory=dama
EnvironmentFile=/etc/dama/dama.env
ExecStart=/usr/bin/node --experimental-sqlite /opt/dama/dist/src/server.js
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
